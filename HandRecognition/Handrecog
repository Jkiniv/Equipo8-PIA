# ============================================================
# BUCLE PRINCIPAL
# ============================================================

try:

    while True:

        success, frame = cap.read()

        if not success:

            print(
                "ERROR: No se pudo obtener una imagen "
                "de la cámara."
            )

            break

        # ----------------------------------------------------
        # VISTA ESPEJO
        # ----------------------------------------------------

        frame = cv2.flip(
            frame,
            1
        )

        height, width, _ = frame.shape

        # ----------------------------------------------------
        # CALCULAR FPS REALES DEL PROGRAMA
        # ----------------------------------------------------

        fps_counter += 1

        fps_current_time = time.perf_counter()
        fps_elapsed_time = (
            fps_current_time - fps_start_time
        )

        if fps_elapsed_time >= 1.0:

            fps_display = (
                fps_counter / fps_elapsed_time
            )

            fps_counter = 0
            fps_start_time = fps_current_time

        # ----------------------------------------------------
        # TIMESTAMP MONÓTONO
        # ----------------------------------------------------

        elapsed_seconds = (
            time.perf_counter()
            - program_start_time
        )

        timestamp_ms = int(
            elapsed_seconds * 1000
        )

        # MediaPipe en modo VIDEO necesita timestamps
        # estrictamente crecientes.
        if timestamp_ms <= last_timestamp_ms:

            timestamp_ms = (
                last_timestamp_ms + 1
            )

        last_timestamp_ms = timestamp_ms

        # ----------------------------------------------------
        # CONVERTIR OPENCV BGR A RGB
        # ----------------------------------------------------

        rgb_frame = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2RGB
        )

        rgb_frame = np.ascontiguousarray(
            rgb_frame
        )

        mp_image = mp.Image(
            image_format=mp.ImageFormat.SRGB,
            data=rgb_frame
        )

        # ----------------------------------------------------
        # DETECCIÓN EN MODO VIDEO
        # ----------------------------------------------------

        pose_result = pose_detector.detect_for_video(
            mp_image,
            timestamp_ms
        )

        hand_result = hand_detector.detect_for_video(
            mp_image,
            timestamp_ms
        )

        # ----------------------------------------------------
        # VARIABLES DEL FRAME ACTUAL
        # ----------------------------------------------------

        arm_detected = False
        selected_hand_detected = False

        shoulder_coordinates = None
        elbow_coordinates = None
        wrist_coordinates = None
        hand_coordinates = None

        hand_label = "Unknown"
        hand_wrist_distance = None

        # ====================================================
        # OBTENER SOLAMENTE EL BRAZO SELECCIONADO
        # ====================================================

        if pose_result.pose_landmarks:

            pose_landmarks = (
                pose_result.pose_landmarks[0]
            )

            shoulder_landmark = (
                pose_landmarks[SHOULDER_INDEX]
            )

            elbow_landmark = (
                pose_landmarks[ELBOW_INDEX]
            )

            wrist_landmark = (
                pose_landmarks[WRIST_INDEX]
            )

            shoulder_visible = landmark_is_visible(
                shoulder_landmark,
                minimum_visibility=0.2
            )

            elbow_visible = landmark_is_visible(
                elbow_landmark,
                minimum_visibility=0.2
            )

            wrist_visible = landmark_is_visible(
                wrist_landmark,
                minimum_visibility=0.2
            )

            if (
                shoulder_visible
                and elbow_visible
                and wrist_visible
            ):

                arm_detected = True

                shoulder_coordinates = (
                    normalized_landmark_to_array(
                        shoulder_landmark
                    )
                )

                elbow_coordinates = (
                    normalized_landmark_to_array(
                        elbow_landmark
                    )
                )

                wrist_coordinates = (
                    normalized_landmark_to_array(
                        wrist_landmark
                    )
                )

                # --------------------------------------------
                # SELECCIONAR MANO CERCANA A LA MUÑECA
                # --------------------------------------------

                (
                    selected_hand,
                    hand_label,
                    hand_wrist_distance
                ) = select_hand_near_pose_wrist(
                    hand_result,
                    wrist_landmark,
                    MAX_HAND_WRIST_DISTANCE
                )

                if selected_hand is not None:

                    selected_hand_detected = True

                    hand_coordinates = np.array(
                        [
                            normalized_landmark_to_array(
                                landmark
                            )
                            for landmark in selected_hand
                        ],
                        dtype=np.float32
                    )

        # ====================================================
        # SUAVIZADO DEL BRAZO
        # ====================================================

        if arm_detected:

            if USE_SMOOTHING:

                shoulder_coordinates = smooth_point(
                    previous_shoulder,
                    shoulder_coordinates,
                    SMOOTHING_ALPHA
                )

                elbow_coordinates = smooth_point(
                    previous_elbow,
                    elbow_coordinates,
                    SMOOTHING_ALPHA
                )

                wrist_coordinates = smooth_point(
                    previous_wrist,
                    wrist_coordinates,
                    SMOOTHING_ALPHA
                )

            previous_shoulder = (
                shoulder_coordinates.copy()
            )

            previous_elbow = (
                elbow_coordinates.copy()
            )

            previous_wrist = (
                wrist_coordinates.copy()
            )

        else:

            previous_shoulder = None
            previous_elbow = None
            previous_wrist = None

        # ====================================================
        # SUAVIZADO DE LA MANO
        # ====================================================

        if selected_hand_detected:

            if USE_SMOOTHING:

                hand_coordinates = smooth_hand(
                    previous_hand,
                    hand_coordinates,
                    SMOOTHING_ALPHA
                )

            previous_hand = (
                hand_coordinates.copy()
            )

        else:

            previous_hand = None

        # ====================================================
        # DIBUJAR BRAZO
        # ====================================================

        if arm_detected:

            arm_color = (
                0,
                255,
                0
            )

            draw_line(
                frame,
                shoulder_coordinates,
                elbow_coordinates,
                width,
                height,
                arm_color,
                thickness=4
            )

            draw_line(
                frame,
                elbow_coordinates,
                wrist_coordinates,
                width,
                height,
                arm_color,
                thickness=4
            )

            # Hombro
            draw_point(
                frame,
                shoulder_coordinates,
                width,
                height,
                (255, 0, 0),
                radius=8
            )

            # Codo
            draw_point(
                frame,
                elbow_coordinates,
                width,
                height,
                (0, 165, 255),
                radius=8
            )

            # Muñeca
            draw_point(
                frame,
                wrist_coordinates,
                width,
                height,
                (0, 0, 255),
                radius=8
            )

        # ====================================================
        # DIBUJAR ÚNICAMENTE LA MANO SELECCIONADA
        # ====================================================

        if selected_hand_detected:

            for (
                connection_start,
                connection_end
            ) in HAND_CONNECTIONS:

                draw_line(
                    frame,
                    hand_coordinates[connection_start],
                    hand_coordinates[connection_end],
                    width,
                    height,
                    (255, 0, 255),
                    thickness=2
                )

            for landmark_index, landmark in enumerate(
                hand_coordinates
            ):

                point_color = (
                    0,
                    255,
                    255
                )

                if landmark_index == HAND_WRIST:

                    point_color = (
                        0,
                        0,
                        255
                    )

                draw_point(
                    frame,
                    landmark,
                    width,
                    height,
                    point_color,
                    radius=4
                )

        # ====================================================
        # INFORMACIÓN GENERAL EN PANTALLA
        # ====================================================

        cv2.putText(
            frame,
            f"Brazo objetivo: {TARGET_ARM.upper()}",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.75,
            (255, 255, 255),
            2
        )

        cv2.putText(
            frame,
            f"FPS: {fps_display:.1f}",
            (width - 150, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.70,
            (255, 255, 255),
            2
        )

        # ====================================================
        # INFORMACIÓN DEL BRAZO
        # ====================================================

        if arm_detected:

            cv2.putText(
                frame,
                "BRAZO DETECTADO",
                (20, 70),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.70,
                (0, 255, 0),
                2
            )

            shoulder_x = float(
                shoulder_coordinates[0]
            )

            shoulder_y = float(
                shoulder_coordinates[1]
            )

            shoulder_z = float(
                shoulder_coordinates[2]
            )

            elbow_x = float(
                elbow_coordinates[0]
            )

            elbow_y = float(
                elbow_coordinates[1]
            )

            elbow_z = float(
                elbow_coordinates[2]
            )

            wrist_x = float(
                wrist_coordinates[0]
            )

            wrist_y = float(
                wrist_coordinates[1]
            )

            wrist_z = float(
                wrist_coordinates[2]
            )

            shoulder_text = (
                f"Shoulder: "
                f"{shoulder_x:.3f}, "
                f"{shoulder_y:.3f}, "
                f"{shoulder_z:.3f}"
            )

            elbow_text = (
                f"Elbow: "
                f"{elbow_x:.3f}, "
                f"{elbow_y:.3f}, "
                f"{elbow_z:.3f}"
            )

            wrist_text = (
                f"Wrist: "
                f"{wrist_x:.3f}, "
                f"{wrist_y:.3f}, "
                f"{wrist_z:.3f}"
            )

            cv2.putText(
                frame,
                shoulder_text,
                (20, 105),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 255, 255),
                2
            )

            cv2.putText(
                frame,
                elbow_text,
                (20, 135),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 255, 255),
                2
            )

            cv2.putText(
                frame,
                wrist_text,
                (20, 165),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 255, 255),
                2
            )

        else:

            cv2.putText(
                frame,
                "BRAZO NO DETECTADO",
                (20, 70),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.70,
                (0, 0, 255),
                2
            )

        # ====================================================
        # INFORMACIÓN DE LA MANO
        # ====================================================

        if selected_hand_detected:

            cv2.putText(
                frame,
                (
                    "MANO DETECTADA | "
                    f"MediaPipe: {hand_label}"
                ),
                (20, 200),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 255, 0),
                2
            )

            hand_wrist_x = float(
                hand_coordinates[0][0]
            )

            hand_wrist_y = float(
                hand_coordinates[0][1]
            )

            hand_wrist_z = float(
                hand_coordinates[0][2]
            )

            hand_wrist_text = (
                f"Hand wrist: "
                f"{hand_wrist_x:.3f}, "
                f"{hand_wrist_y:.3f}, "
                f"{hand_wrist_z:.3f}"
            )

            cv2.putText(
                frame,
                hand_wrist_text,
                (20, 230),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 255, 255),
                2
            )

            if hand_wrist_distance is not None:

                distance_text = (
                    "Distancia Pose-Hand: "
                    f"{hand_wrist_distance:.3f}"
                )

                cv2.putText(
                    frame,
                    distance_text,
                    (20, 260),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (255, 255, 255),
                    2
                )

        else:

            cv2.putText(
                frame,
                "MANO DEL BRAZO NO DETECTADA",
                (20, 200),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 0, 255),
                2
            )

        # ====================================================
        # INSTRUCCIÓN DE SALIDA
        # ====================================================

        cv2.putText(
            frame,
            "ESC: salir",
            (20, height - 20),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.55,
            (200, 200, 200),
            1
        )

        # ====================================================
        # IMPRIMIR COORDENADAS EN TERMINAL
        # ====================================================

        current_time = time.perf_counter()

        if (
            arm_detected
            and selected_hand_detected
            and (
                current_time - last_print_time
                >= PRINT_INTERVAL_SECONDS
            )
        ):

            print_robot_coordinates(
                timestamp_ms=timestamp_ms,
                shoulder=shoulder_coordinates,
                elbow=elbow_coordinates,
                wrist=wrist_coordinates,
                hand=hand_coordinates
            )

            last_print_time = current_time

        # ====================================================
        # MOSTRAR VENTANA
        # ====================================================

        cv2.imshow(
            "MediaPipe - Control de robot 7-DOF",
            frame
        )

        key = cv2.waitKey(1) & 0xFF

        if key == 27:

            print(
                "\nPrograma detenido manualmente."
            )

            break


# ============================================================
# LIBERAR RECURSOS
# ============================================================

finally:

    cap.release()

    pose_detector.close()
    hand_detector.close()

    cv2.destroyAllWindows()

    print(
        "Cámara y detectores cerrados correctamente."
    )
    