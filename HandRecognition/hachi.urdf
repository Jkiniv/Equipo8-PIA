<?xml version="1.0"?>
<robot name="humanoid_shoulder_arm_l_shape">

  <!-- Base Link: Inverse L-shape (1.2m tall thin vertical post + horizontal overhang) -->
  <link name="base_link">
    <!-- Vertical Post (Taller and thinner: 1.2m height, 0.03m radius) -->
    <visual>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="1.2"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="1.2"/>
      </geometry>
    </collision>

    <!-- Horizontal Protrusion (The top bar of the inverse L-shape) -->
    <visual>
      <origin xyz="0.1 0 1.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.06 0.06"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.1 0 1.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.06 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="8.0"/>
      <origin xyz="0.05 0 0.6"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Joint 1: Shoulder Yaw (Attached at the end of the L-shape protrusion) -->
  <link name="shoulder_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_base_link"/>
    <origin xyz="0.2 0 1.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="3.0"/>
  </joint>

  <!-- Joint 2: Shoulder Pitch (Upper Arm) -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="3.0"/>
  </joint>

  <!-- Joint 3: Elbow Pitch (Forearm) -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.8" effort="50" velocity="3.0"/>
  </joint>

  <!-- Joint 4: Wrist Roll -->
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.05"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="5.0"/>
  </joint>

  <!-- Joint 5: Wrist Pitch -->
  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.05"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="20" velocity="5.0"/>
  </joint>

  <!-- ===================================================== -->
  <!-- GARRA PARALELA SIMPLE DE DOS DEDOS                    -->
  <!-- ===================================================== -->

  <!-- Base fija de la garra -->
  <link name="gripper_base_link">

    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>

      <material name="gripper_base_red">
        <color rgba="0.80 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.20"/>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>


  <!-- La base de la garra queda unida de forma fija
       a la última articulación de la muñeca -->
  <joint name="gripper_base_joint" type="fixed">

    <parent link="wrist_2_link"/>
    <child link="gripper_base_link"/>

    <origin xyz="0 0 -0.10" rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- DEDO IZQUIERDO                                        -->
  <!-- ===================================================== -->

  <link name="left_finger_link">

    <visual>
      <!-- El dedo se extiende hacia abajo desde su joint -->
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.12"/>
      </geometry>

      <material name="left_finger_blue">
        <color rgba="0.10 0.30 0.90 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.08"/>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <inertia
        ixx="0.0002"
        ixy="0"
        ixz="0"
        iyy="0.0002"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>


  <!-- Joint 6: dedo izquierdo.
       Se desplaza hacia Y positivo al abrirse. -->
  <joint name="joint_6" type="prismatic">

    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>

    <!-- Posición inicial del dedo junto al centro -->
    <origin xyz="0 0.015 -0.05" rpy="0 0 0"/>

    <!-- Movimiento lateral -->
    <axis xyz="0 1 0"/>

    <!-- 0.00 m = cerrada
         0.04 m = abierta -->
    <limit
      lower="0.0"
      upper="0.04"
      effort="10"
      velocity="0.20"/>

  </joint>


  <!-- ===================================================== -->
  <!-- DEDO DERECHO                                          -->
  <!-- ===================================================== -->

  <link name="right_finger_link">

    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.12"/>
      </geometry>

      <material name="right_finger_blue">
        <color rgba="0.10 0.30 0.90 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.08"/>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <inertia
        ixx="0.0002"
        ixy="0"
        ixz="0"
        iyy="0.0002"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>


  <!-- Joint 7: dedo derecho.
       Se desplaza hacia Y negativo al abrirse. -->
  <joint name="joint_7" type="prismatic">

    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>

    <origin xyz="0 -0.015 -0.05" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <!-- El rango es negativo porque abre hacia el lado opuesto -->
    <limit
      lower="-0.04"
      upper="0.0"
      effort="10"
      velocity="0.20"/>

  </joint>

</robot>